<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Parakh report: {{ r.scenario_title }}</title>
<style>
:root {
  --bg: #ffffff; --fg: #1a1a1a; --muted: #5c5c5c; --line: #d9d9d9;
  --bar: #2b6cb0; --miss-bg: #ffe0e0; --miss-fg: #8a1c1c; --warn: #8a5a00;
}
@media (prefers-color-scheme: dark) {
  :root {
    --bg: #14171a; --fg: #e8e8e8; --muted: #a0a0a0; --line: #343a40;
    --bar: #63a4e8; --miss-bg: #5a2323; --miss-fg: #ffd0d0; --warn: #e8b84a;
  }
}
body { background: var(--bg); color: var(--fg); font: 16px/1.5 system-ui, sans-serif;
  max-width: 60rem; margin: 0 auto; padding: 1rem; }
h1, h2 { line-height: 1.2; }
table { border-collapse: collapse; width: 100%; margin: 0.5rem 0 1.5rem; }
th, td { border-bottom: 1px solid var(--line); padding: 0.3rem 0.5rem; text-align: left;
  vertical-align: top; overflow-wrap: anywhere; }
th { color: var(--muted); font-weight: 600; width: 14rem; }
mark.miss { background: var(--miss-bg); color: var(--miss-fg); padding: 0 0.15em; }
.muted { color: var(--muted); }
.warn { color: var(--warn); }
.chart { max-width: 100%; height: auto; }
.chart text { fill: var(--fg); font-size: 11px; text-anchor: middle; }
.chart rect { fill: var(--bar); }
audio { width: 100%; margin: 0.25rem 0 1rem; }
.turn { border-top: 1px solid var(--line); padding: 0.5rem 0; }
</style>
</head>
<body>
<h1>{{ r.scenario_title }}</h1>
<p class="muted">{{ r.scenario_id }} / {{ r.language }} / preset {{ r.preset }}{% if r.seed is not none %} / seed {{ r.seed }}{% endif %} / {{ r.created_at }}</p>
{% if r.timing_unreliable %}
<p class="warn">Timing is unreliable for this run.</p>
{% endif %}
{% for w in r.warnings %}
<p class="warn">{{ w }}</p>
{% endfor %}

<h2>Metrics</h2>
<table>
<tr><th>Status</th><td>{{ r.status }}</td></tr>
<tr><th>Latency p50 / p90 / p95 / max</th><td>{{ r.metrics.latency.p50_ms | ms }} / {{ r.metrics.latency.p90_ms | ms }} / {{ r.metrics.latency.p95_ms | ms }} / {{ r.metrics.latency.max_ms | ms }}</td></tr>
<tr><th>Turns with latency</th><td>{{ r.metrics.latency.n }}</td></tr>
{% if r.metrics.stop_latency %}
<tr><th>Barge-in stop latency p50 / p95 / max</th><td>{{ r.metrics.stop_latency.p50_ms | ms }} / {{ r.metrics.stop_latency.p95_ms | ms }} / {{ r.metrics.stop_latency.max_ms | ms }}</td></tr>
<tr><th>Did not yield</th><td>{{ r.metrics.did_not_yield }}</td></tr>
{% endif %}
{% if r.metrics.stop_latency or r.metrics.false_barge_in_ms %}
<tr><th>False barge-ins</th><td>{{ r.metrics.false_barge_in_ms | length }}{% if r.metrics.false_barge_in_ms %} (at {% for v in r.metrics.false_barge_in_ms %}{{ v | ms }}{% if not loop.last %}, {% endif %}{% endfor %}){% endif %}</td></tr>
{% endif %}
<tr><th>Strict WER</th><td>{{ r.metrics.strict_wer | pct }}</td></tr>
<tr><th>Loose WER</th><td>{{ r.metrics.loose_wer | pct }}</td></tr>
<tr><th>Loose CER</th><td>{{ r.metrics.loose_cer | pct }}</td></tr>
{% if r.metrics.wer_reason %}
<tr><th>WER note</th><td>{{ r.metrics.wer_reason }}</td></tr>
{% endif %}
<tr><th>Caller pacing jitter p50 / p99 / max</th><td>{{ r.jitter.p50_ms | ms }} / {{ r.jitter.p99_ms | ms }} / {{ r.jitter.max_ms | ms }}</td></tr>
<tr><th>Peak CPU</th><td>{{ "%.0f"|format(r.cpu_max_percent) }}%</td></tr>
</table>

<h2>Agent</h2>
<table>
<tr><th>URL</th><td>{{ r.agent_url }}</td></tr>
{% for key, value in r.agent_info.items() %}
<tr><th>{{ key }}</th><td>{{ value }}</td></tr>
{% else %}
<tr><th>Info</th><td>n/a</td></tr>
{% endfor %}
</table>

<h2>Latency per turn</h2>
<svg class="chart" role="img" aria-label="Response latency per turn" viewBox="0 0 {{ chart_w }} {{ chart_h }}" width="{{ chart_w }}" height="{{ chart_h }}">
{% for b in bars %}
  <rect x="{{ b.x }}" y="{{ b.y }}" width="{{ bar_w }}" height="{{ b.height }}"></rect>
  <text x="{{ b.x + bar_w / 2 }}" y="{{ b.y - 4 }}">{{ b.label }}</text>
  <text x="{{ b.x + bar_w / 2 }}" y="{{ chart_h - 6 }}">T{{ b.turn }}</text>
{% endfor %}
</svg>

<h2>Audio</h2>
<p>Caller</p>
<audio controls src="caller.wav"></audio>
<p>Agent</p>
<audio controls src="agent.wav"></audio>

<h2>Transcript</h2>
{% for item in turns %}
{% set t = item.turn %}
<div class="turn">
<p><strong>Turn {{ t.index + 1 }}</strong>
 <span class="muted">latency {{ t.latency_ms | ms }}{% if t.latency_reason %} ({{ t.latency_reason }}){% endif %}, strict WER {{ t.strict_wer | pct }}, loose WER {{ t.loose_wer | pct }}</span></p>
{% if t.degradation %}
<p class="muted">line: SNR {{ "n/a" if t.degradation.snr_db is none else "%.1f"|format(t.degradation.snr_db) }} dB (at mixing), lost {{ t.degradation.lost_frames }}/{{ t.degradation.frames }} frames, clipped {{ t.degradation.clipped_samples }} samples</p>
{% endif %}
{% if t.barge_in %}
{% set b = t.barge_in %}
<p class="muted">barge-in after {{ b.after_agent_ms | ms }}: {% if b.result == "yielded" %}stopped in {{ b.stop_latency_ms | ms }} ({{ b.via }}){% elif b.result == "did_not_yield" %}did not yield within 2 s{% else %}agent finished first{% endif %}</p>
{% endif %}
<p>Said: {{ t.say }}</p>
<p>Reference: {{ t.reference }}</p>
<p>Heard: {% for word, miss in item.words %}{% if miss %}<mark class="miss">{{ word }}</mark>{% else %}{{ word }}{% endif %}{% if not loop.last %} {% endif %}{% else %}<span class="muted">n/a</span>{% endfor %}</p>
<p>Agent replied: {{ t.agent_text or "n/a" }}</p>
<p class="muted">Agent TTFB: {% if t.agent_ttfb_ms %}{% for v in t.agent_ttfb_ms %}{{ v | ms }}{% if not loop.last %}, {% endif %}{% endfor %}{% else %}n/a{% endif %}</p>
</div>
{% endfor %}
</body>
</html>
