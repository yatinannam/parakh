# Copy to .env and fill in. Never commit .env.
# The OpenRouter key used for the Calibrate evaluation lives only in WSL at ~/calibrate-eval/.env.

# Groq free tier: test agent STT and LLM, and the LLM judge.
GROQ_API_KEY=

# Gemini free tier: judge fallback (M3). Free tier may train on inputs; send synthetic data only.
GEMINI_API_KEY=
